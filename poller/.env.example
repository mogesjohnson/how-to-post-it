# Copy to ~/.post-it-poller/env and `chmod 600 ~/.post-it-poller/env`. NEVER commit the real file.
# Placeholder names only; one KEY=VALUE per line; values are read literally (quotes optional).

# Required: the full Cookie header value of a signed-in grok.com browser session (full account access!)
GROK_COOKIE=<paste grok.com cookie string here>
# Required: fine-grained GitHub token, ONLY mogesjohnson/post-it-board, Contents: read and write, <= 90 days
INBOX_GITHUB_TOKEN=<fine-grained token>

# Optional (defaults shown)
# READER=rest                 # rest | browser (browser is a TODO stub)
# QUIET_MINUTES=10            # finished = newest message and modifyTime both this old
# POLL_SECONDS=90             # clamped to 60-120
# MAX_BACKOFF_SECONDS=600
# INBOX_REPO=mogesjohnson/post-it-board
# INBOX_BRANCH=inbox
# LLAMA_DIR=/workspace/llm/llama-b11559
# LLAMA_MODEL=/workspace/llm/qwen35-2b-q4km.gguf
# LLAMA_THREADS=8
# SUMMARIZER_MIN_FREE_MB=1500 # skip (and retry later) when less RAM is free
# Topic papers (the board is read with its PUBLIC anon key from the site's config.js; no secret needed)
# BOARD_CONFIG=https://mogesjohnson.github.io/post-it-board/config.js
# TOPICS_EXCLUDE=Post-it Board
# MAX_TOPICS=40
# COMPACT_THRESHOLD=1500
# COMPACT_TARGET=1000
